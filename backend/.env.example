# Copy to backend/.env and fill in. Never commit .env.
LINGORA_ENV=dev
# Local dev database (embedded PostgreSQL on port 54329):
LINGORA_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/lingora
# Supabase: Project settings -> Database -> Connection string -> "Session pooler" (IPv4), psycopg form:
# LINGORA_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
LINGORA_ALLOWED_ORIGINS=http://localhost:5173
# Long random value outside dev:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LINGORA_SECRET_KEY=dev-only-change-me
LINGORA_COOKIE_SECURE=false
LINGORA_SPEECH_ENABLED=false
