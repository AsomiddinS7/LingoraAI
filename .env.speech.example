# Server-only credentials. Copy to .env.speech and NEVER commit that file.
# Run with Node 22+: node --env-file=.env.speech scripts/speech-server.mjs
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SPEECH_PORT=8787
SPEECH_HOST=127.0.0.1
# Serve the built app and token endpoint together (run npm run build first).
SPEECH_SERVE_DIST=true
# Exact public origin, including port locally. Production uses your HTTPS origin.
# A reverse proxy must preserve the public Host header.
SPEECH_PUBLIC_ORIGIN=http://localhost:8787
# Origins have no trailing slash or URL path. Add only frontend origins you control.
SPEECH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://asomiddins7.github.io
# Frontend build configuration goes in .env.local, not in this server env file:
# VITE_SPEECH_TOKEN_URL=https://your-token-server.example/api/speech-token
