{
  "name": "lingora",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:speech-server": "node --test tests/speech-server.test.mjs",
    "test:model-pipeline": "node --test tests/training-export.test.mjs tests/model-provenance.test.mjs tests/temporal-inference.test.mjs tests/quantize-motion.test.mjs tests/masked-dtw.test.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test:speech-readiness": "node --test tests/speech-readiness.test.mjs",
    "model:export": "node scripts/export-training-data.mjs",
    "model:train": "python tools/ml/train_temporal.py",
    "model:evaluate": "node scripts/evaluate-temporal-candidate.mjs",
    "model:optimize": "node scripts/quantize-motion.mjs",
    "speech:check": "node scripts/check-speech-readiness.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:presentation": "node scripts/presentation-smoke.mjs",
    "speech:dev": "node --env-file=.env.speech scripts/speech-server.mjs",
    "start": "node scripts/speech-server.mjs",
    "start:local": "node --env-file-if-exists=.env.speech scripts/start-local.mjs",
    "package:local": "node scripts/package-local.mjs",
    "package:archive": "python scripts/package_local_archive.py"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.65.1",
    "typescript": "5.6.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.24.0"
  }
}
