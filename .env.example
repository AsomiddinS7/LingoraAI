# Lingora public build settings. Keep subscription keys in server-only configuration.
# Every value can also be overridden at runtime in the Console screen (#/console) for demos.

# Speech to text: typed-input | browser-speech | local-stt (own CPU service) | azure-speech
VITE_STT_PROVIDER=browser-speech

# Text to speech: browser-synthesis | local-tts (own free neural voice service) | azure-speech
VITE_TTS_PROVIDER=browser-synthesis

# Face and head hints (Plan A only): on | off
VITE_FACE_HINTS=off

# Confirmed label wording: local (no generated meaning) | azure-openai | mock
VITE_LLM_PROVIDER=local

# true = every /api call is answered by the in-browser mock server (development, tests, preview)
VITE_MOCK_AZURE=true

# Recognizer: motion (bundled temporal references) | static (locally collected shapes) | sequence | mock
VITE_RECOGNIZER=motion

# Compiled model assets contain normalized features, without raw video/source metadata.
VITE_MOTION_MODEL_URL=model/trained-sign-model.json
VITE_SIGNED_SPEECH_MODEL_URL=model/signed-speech-model.json
VITE_LOCAL_STT_URL=http://127.0.0.1:8790
VITE_LOCAL_TTS_URL=http://127.0.0.1:8792
# For the huggingface providers, use the verified Space app URL (*.hf.space).
VITE_SPEECH_SPACE_URL=

# Real Azure Speech token endpoint. Never place a subscription key in a VITE_ variable.
VITE_SPEECH_TOKEN_URL=

# Data collection policy: consenting-teammates (Plan B default) | tutor-confirmed
VITE_DATA_COLLECTION=consenting-teammates

# Confidence threshold below which "Not recognized" is shown (0..1)
VITE_CONFIDENCE_THRESHOLD=0.80

# Base URL of the team backend when VITE_MOCK_AZURE=false (same origin if empty)
VITE_API_BASE=
