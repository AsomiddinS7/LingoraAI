# SignConnect config switches (brief section 2). No secrets belong here or anywhere in the app.
# Every value can also be overridden at runtime in the Console screen (#/console) for demos.

# Speech to text: typed-input (Plan B default) | browser-speech (experimental) | azure-speech (Plan A)
VITE_STT_PROVIDER=typed-input

# Text to speech: browser-synthesis (Plan B default) | azure-speech (Plan A)
VITE_TTS_PROVIDER=browser-synthesis

# Face and head hints (Plan A only): on | off
VITE_FACE_HINTS=off

# Sentence model: azure-openai | mock
VITE_LLM_PROVIDER=azure-openai

# true = every /api call is answered by the in-browser mock server (development, tests, preview)
VITE_MOCK_AZURE=true

# Sign classifier: mock | model (model = the team's classifier loaded from /model)
VITE_SIGN_CLASSIFIER=mock

# Data collection policy: consenting-teammates (Plan B default) | tutor-confirmed
VITE_DATA_COLLECTION=consenting-teammates

# Confidence threshold below which "Not recognized" is shown (0..1)
VITE_CONFIDENCE_THRESHOLD=0.80

# Base URL of the team backend when VITE_MOCK_AZURE=false (same origin if empty)
VITE_API_BASE=
